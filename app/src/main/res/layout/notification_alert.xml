<?xml version="1.0" encoding="utf-8"?><!--
    The opened shape of an alert: what happened in full, and the picture under it.

    The system's own big picture stops the text at two lines, which cuts a
    description off halfway. This is used instead once there is a sentence to
    read, and the picture is the large icon while the notification is closed.

    The system draws the app name and the collapse arrow above this, so it starts
    with the title.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="4dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/alert_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:lineSpacingMultiplier="1.15"
        android:maxLines="2"
        android:textColor="@color/alert_title"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/alert_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingMultiplier="1.2"
        android:textColor="@color/alert_text"
        android:textSize="14sp" />

    <ImageView
        android:id="@+id/alert_picture"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="12dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />
</LinearLayout>
