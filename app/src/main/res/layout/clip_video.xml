<?xml version="1.0" encoding="utf-8"?>
<!--
    A clip's own picture. It is drawn into a texture rather than into a surface of
    its own, because a surface is laid over the page by the system and Compose
    cannot move, scale or clip it, and a clip gets pinched and dragged. The bar of
    controls is drawn by the viewer in the app's colours, so the player's own are
    off.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clip_video"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:resize_mode="fit"
    app:show_buffering="never"
    app:surface_type="texture_view"
    app:use_controller="false" />
